{"id": "high-frequency-01-noise-01", "layer": "generation", "category": "high-frequency", "difficulty": "easy", "question": "怎么退货？", "query": "怎么退货？", "golden_answer": "支持 7 天无理由退货：登录 App 在订单页点「申请退货」，质量问题需上传照片/视频，无理由退货填原因即可；客服 1 个工作日内审核，通过后提供退货地址与 RMA 号，请勿在未获得 RMA 号前自行寄回。", "golden_context": ["returns-refunds"], "golden_context_ids": ["returns-refunds"], "metadata_filter": {"source": "returns-refunds"}, "answer_type": "流程说明", "key_points": ["7天无理由", "申请退货", "RMA号"], "reference_points": ["7天无理由", "申请退货", "RMA号"], "should_refuse": false, "weight": 1.0, "golden_sections": ["returns-refunds::7 天无理由退货条件", "returns-refunds::退货申请流程"], "golden_chunk_ids": ["returns-refunds:p0:c0", "returns-refunds:p0:c1", "returns-refunds:p0:c2", "returns-refunds:p0:c3"], "intent": "流程说明", "emotion": "neutral", "base_id": "high-frequency-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 14.254, "injected_noise_title": "退货期限是多久", "noise_position": 2}
{"id": "high-frequency-02-noise-02", "layer": "generation", "category": "high-frequency", "difficulty": "easy", "question": "保修多久？", "query": "保修多久？", "golden_answer": "智能音箱整机保修 1 年，主要部件（扬声器单元、主板、电源适配器）保修 2 年；智能家居网关保修 2 年；传感器类设备保修 1 年；执行器类（智能灯泡、插座、窗帘电机）保修 1.5 年；电池属消耗品不保修。可付费延保：音箱 ¥299 延至 3 年、¥499 延至 5 年。", "golden_context": ["warranty-service"], "golden_context_ids": ["warranty-service"], "metadata_filter": {"source": "warranty-service"}, "answer_type": "事实问答", "key_points": ["整机1年", "主要部件2年", "延保"], "reference_points": ["整机1年", "主要部件2年", "延保"], "should_refuse": false, "weight": 1.0, "golden_sections": ["warranty-service::保修期限总表", "warranty-service::延保服务"], "golden_chunk_ids": ["warranty-service:p0:c0", "warranty-service:p0:c1", "warranty-service:p1:c2", "warranty-service:p1:c3"], "intent": "事实问答", "emotion": "neutral", "base_id": "high-frequency-02", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 17.8351, "injected_noise_title": "产品保修期是多久", "noise_position": 2}
{"id": "high-frequency-04-noise-03", "layer": "generation", "category": "high-frequency", "difficulty": "medium", "question": "音箱怎么连WiFi？", "query": "音箱怎么连WiFi？", "golden_answer": "首次开机自动进入配网模式（蓝灯快闪）；未自动进入时长按顶部静音键 5 秒手动进入。打开「智联生活」App 点「添加设备」→「智能音箱」，选择对应型号按提示连接家中 WiFi。注意：X-100 仅支持 2.4GHz 网络，X-200/X-300 Pro 支持 2.4G/5G。", "golden_context": ["installation-guide", "product-manual"], "golden_context_ids": ["installation-guide", "product-manual"], "metadata_filter": {"source": "installation-guide"}, "answer_type": "流程说明", "key_points": ["配网模式", "智联生活App", "2.4GHz"], "reference_points": ["配网模式", "智联生活App", "2.4GHz"], "should_refuse": false, "weight": 1.0, "golden_sections": ["installation-guide::安装前准备清单", "installation-guide::智能音箱配网步骤(iOS)"], "golden_chunk_ids": ["installation-guide:p0:c0", "installation-guide:p0:c1", "installation-guide:p0:c2"], "intent": "流程说明", "emotion": "neutral", "base_id": "high-frequency-04", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 14.074, "injected_noise_title": "音箱三个型号怎么选", "noise_position": 2}
{"id": "online-failure-01-noise-01", "layer": "generation", "category": "online-failure", "difficulty": "medium", "question": "网关一直反复重启，怎么处理？", "query": "网关一直反复重启，怎么处理？", "golden_answer": "E013 指网关陷入启动循环、指示灯反复熄灭点亮。自查：1) 更换电源适配器与插座（G1 用 15W USB-C）；2) 拔掉 USB 天线再上电测试；3) 长按 Reset 10 秒完全重置。自查无效需报修，多为电源或主板故障，网关保修 2 年内免费。", "golden_context": ["error-codes"], "golden_context_ids": ["error-codes"], "metadata_filter": {"source": "error-codes"}, "answer_type": "流程说明", "key_points": ["E013", "电源适配器", "Reset 10秒"], "reference_points": ["E013", "电源适配器", "Reset 10秒"], "should_refuse": false, "weight": 1.0, "golden_sections": ["error-codes::E013 网关反复重启"], "golden_chunk_ids": ["error-codes:p1:c2", "error-codes:p1:c3"], "intent": "流程说明", "emotion": "frustrated", "base_id": "online-failure-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 10.1106, "injected_noise_title": "音箱三个型号怎么选", "noise_position": 2}
{"id": "online-failure-02-noise-02", "layer": "generation", "category": "online-failure", "difficulty": "easy", "question": "网关离线连不上了，怎么排查？", "query": "网关离线连不上了，怎么排查？", "golden_answer": "E011 指网关与云端失联超过 10 分钟。自查：1) 看网关指示灯：红灯离线、白灯正常；2) 检查路由器，改过 WiFi 密码需重新配网（长按 Reset 5 秒黄灯闪烁）；3) G2 Pro 优先插网线；4) 将网关移近路由器 3 米内。排查后仍每天离线多次需提交工单；指示灯不亮见 E013。", "golden_context": ["error-codes"], "golden_context_ids": ["error-codes"], "metadata_filter": {"source": "error-codes"}, "answer_type": "流程说明", "key_points": ["E011", "红灯离线", "重新配网"], "reference_points": ["E011", "红灯离线", "重新配网"], "should_refuse": false, "weight": 1.0, "golden_sections": ["error-codes::E011 网关离线"], "golden_chunk_ids": ["error-codes:p1:c1", "error-codes:p1:c2"], "intent": "流程说明", "emotion": "neutral", "base_id": "online-failure-02", "noise_probe": true, "injected_noise_chunk_id": "troubleshooting:p0:c0", "injected_noise_source": "troubleshooting", "injected_noise_score": 18.2188, "injected_noise_title": "子设备离线", "noise_position": 2}
{"id": "online-failure-03-noise-03", "layer": "generation", "category": "online-failure", "difficulty": "medium", "question": "智能插座一过载就断电，怎么恢复？", "query": "智能插座一过载就断电，怎么恢复？", "golden_answer": "E018 指负载超过 2500W/10A，插座自动断电保护。自查：1) 移除电暖器、电热水器等大功率电器或改插墙插；2) App 中点「恢复供电」；3) 核对所接电器铭牌功率。无负载或小负载（<100W）仍频繁报过载属计量模块故障，需报修，插座保修 1.5 年。", "golden_context": ["error-codes"], "golden_context_ids": ["error-codes"], "metadata_filter": {"source": "error-codes"}, "answer_type": "流程说明", "key_points": ["E018", "2500W/10A", "恢复供电"], "reference_points": ["E018", "2500W/10A", "恢复供电"], "should_refuse": false, "weight": 1.0, "golden_sections": ["error-codes::E018 智能插座过载保护"], "golden_chunk_ids": ["error-codes:p2:c1", "error-codes:p2:c2"], "intent": "流程说明", "emotion": "neutral", "base_id": "online-failure-03", "noise_probe": true, "injected_noise_chunk_id": "troubleshooting:p0:c0", "injected_noise_source": "troubleshooting", "injected_noise_score": 19.5409, "injected_noise_title": "智能插座通电但设备不工作", "noise_position": 2}
{"id": "business-critical-01-noise-01", "layer": "generation", "category": "business-critical", "difficulty": "hard", "question": "退货运费谁承担？", "query": "退货运费谁承担？", "golden_answer": "按退货原因区分：7 天无理由退货寄回运费由用户承担；15 天内质量问题退换、错发/漏发/破损拒收，来回运费由我方承担（可选顺丰到付或先垫付后凭单据报销，上限 ¥25）；无理由换货（如换颜色）寄回运费用户承担、补发运费我方承担。", "golden_context": ["returns-refunds"], "golden_context_ids": ["returns-refunds"], "metadata_filter": {"source": "returns-refunds"}, "answer_type": "事实问答", "key_points": ["无理由用户承担", "质量问题我方承担", "报销上限25元"], "reference_points": ["无理由用户承担", "质量问题我方承担", "报销上限25元"], "should_refuse": false, "weight": 1.0, "golden_sections": ["returns-refunds::退货政策总览", "returns-refunds::退货运费承担规则"], "golden_chunk_ids": ["returns-refunds:p0:c0", "returns-refunds:p1:c4", "returns-refunds:p1:c5"], "intent": "事实问答", "emotion": "neutral", "base_id": "business-critical-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 23.0107, "injected_noise_title": "退货期限是多久", "noise_position": 2}
{"id": "business-critical-02-noise-02", "layer": "generation", "category": "business-critical", "difficulty": "hard", "question": "增值税专用发票怎么开？流程和时限？", "query": "增值税专用发票怎么开？流程和时限？", "golden_answer": "企业用户可申请增值税专用发票（纸质）：需提供公司名称、税号、注册地址与电话、开户银行及账号，并上传一般纳税人资质（首次）。审核通过后 5-10 个工作日开出并顺丰寄出（免邮）。专票金额为实付金额；专票订单发生退货需先完成发票冲红（电子退回或寄回纸质发票）方可退款，冲红增加 3-5 个工作日处理时间。", "golden_context": ["billing-invoices"], "golden_context_ids": ["billing-invoices"], "metadata_filter": {"source": "billing-invoices"}, "answer_type": "流程说明", "key_points": ["专票5-10个工作日", "一般纳税人资质", "冲红"], "reference_points": ["专票5-10个工作日", "一般纳税人资质", "冲红"], "should_refuse": false, "weight": 1.0, "golden_sections": ["billing-invoices::增值税专用发票开具"], "golden_chunk_ids": ["billing-invoices:p0:c2", "billing-invoices:p0:c3"], "intent": "流程说明", "emotion": "neutral", "base_id": "business-critical-02", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 20.7011, "injected_noise_title": "可以开发票吗", "noise_position": 2}
{"id": "business-critical-03-noise-03", "layer": "generation", "category": "business-critical", "difficulty": "hard", "question": "云服务退订能退多少钱？", "query": "云服务退订能退多少钱？", "golden_answer": "随时可退订：App「会员中心」→「管理订阅」→「退订并退款」。退款 = 实付金额 × 剩余天数 ÷ 订阅总天数（当天按已使用计），原路退回 1-7 个工作日到账。示例：年付家庭版 ¥180，使用 73 天后退订，退款 = 180 × (365-73) ÷ 365 ≈ ¥144.00。优惠券支付部分不退现金，退还等值优惠券（有效期内）。退订后立即降为免费版。", "golden_context": ["billing-invoices"], "golden_context_ids": ["billing-invoices"], "metadata_filter": {"source": "billing-invoices"}, "answer_type": "事实问答", "key_points": ["退款公式", "剩余天数", "优惠券不返现"], "reference_points": ["退款公式", "剩余天数", "优惠券不返现"], "should_refuse": false, "weight": 1.0, "golden_sections": ["billing-invoices::云服务订阅计费规则", "billing-invoices::优惠券规则"], "golden_chunk_ids": ["billing-invoices:p0:c4", "billing-invoices:p1:c0", "billing-invoices:p1:c2", "billing-invoices:p1:c3"], "intent": "事实问答", "emotion": "neutral", "base_id": "business-critical-03", "noise_probe": true, "injected_noise_chunk_id": "returns-refunds:p0:c0", "injected_noise_source": "returns-refunds", "injected_noise_score": 17.3305, "injected_noise_title": "云服务退订与退款", "noise_position": 2}
{"id": "multi-hop-01-noise-01", "layer": "generation", "category": "multi-hop", "difficulty": "hard", "question": "我买了音箱和网关套装，想退音箱但保留网关，运费怎么算？", "query": "我买了音箱和网关套装，想退音箱但保留网关，运费怎么算？", "golden_answer": "套装拆开部分退货（如只退音箱）时：该商品按对应退货规则处理——若是质量问题，来回运费由我方承担（顺丰到付或先垫付后报销，上限 ¥25）；若是无理由退货，寄回运费由用户承担。注意：套装订单使用优惠券支付的部分，部分退货时券按比例摊入不返还；积分抵扣部分随退款返还积分。", "golden_context": ["returns-refunds"], "golden_context_ids": ["returns-refunds"], "metadata_filter": {"source": "returns-refunds"}, "answer_type": "多跳推理", "key_points": ["部分退货", "券按比例摊入", "运费规则", "套装类商品退货"], "reference_points": ["部分退货", "券按比例摊入", "运费规则"], "should_refuse": false, "weight": 1.0, "golden_sections": ["returns-refunds::套装类商品退货规则"], "golden_chunk_ids": ["returns-refunds:p1:c0", "returns-refunds:p1:c1"], "intent": "多跳推理", "emotion": "neutral", "required_key_points": ["套装类商品退货", "运费规则"], "multi_hop": true, "base_id": "multi-hop-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 24.6299, "injected_noise_title": "音箱三个型号怎么选", "noise_position": 2}
{"id": "multi-hop-02-noise-02", "layer": "generation", "category": "multi-hop", "difficulty": "hard", "question": "退订云服务后，我存在云端的录像还能看多久？", "query": "退订云服务后，我存在云端的录像还能看多久？", "golden_answer": "退订后立即降为免费版：云存储容量从套餐额度降为免费版 5GB，超出 5GB 的数据保留 30 天供下载，逾期删除；回放期限同步降为免费版策略（免费版 3 天滚动）。若在 30 天冷静期内撤销注销或重新订阅，数据可保留。建议退订前先通过「数据导出」或下载重要录像。", "golden_context": ["billing-invoices", "error-codes"], "golden_context_ids": ["billing-invoices", "error-codes"], "metadata_filter": {"source": "billing-invoices"}, "answer_type": "多跳推理", "key_points": ["降为免费版", "保留30天", "回放3天滚动"], "reference_points": ["降为免费版", "保留30天", "回放3天滚动"], "should_refuse": false, "weight": 1.0, "golden_sections": ["billing-invoices::云服务订阅计费规则"], "golden_chunk_ids": ["billing-invoices:p0:c4", "billing-invoices:p1:c0"], "intent": "多跳推理", "emotion": "neutral", "required_key_points": ["降为免费版", "保留30天"], "multi_hop": true, "base_id": "multi-hop-02", "noise_probe": true, "injected_noise_chunk_id": "returns-refunds:p0:c0", "injected_noise_source": "returns-refunds", "injected_noise_score": 19.585, "injected_noise_title": "云服务退订与退款", "noise_position": 2}
{"id": "multi-hop-03-noise-03", "layer": "generation", "category": "multi-hop", "difficulty": "hard", "question": "改了密码后为什么所有设备都要重新登录？", "query": "改了密码后为什么所有设备都要重新登录？", "golden_answer": "这是账号安全机制：改密后登录令牌失效，所有已登录设备需重新登录（E036 登录令牌失效即此原因）。若手机丢失，应立即在他人的手机上登录自己账号，到「登录设备管理」下线旧设备、改密并开启登录保护，换新号后 30 天内可换绑 1 次。", "golden_context": ["account-security", "error-codes"], "golden_context_ids": ["account-security", "error-codes"], "metadata_filter": {"source": "account-security"}, "answer_type": "多跳推理", "key_points": ["令牌失效", "下线设备", "换绑1次"], "reference_points": ["令牌失效", "下线设备", "换绑1次"], "should_refuse": false, "weight": 1.0, "golden_sections": ["account-security::登录方式与登录保护", "error-codes::E036 登录令牌失效"], "golden_chunk_ids": ["account-security:p0:c0", "account-security:p0:c1", "error-codes:p4:c2"], "intent": "多跳推理", "emotion": "neutral", "required_key_points": ["令牌失效", "下线设备"], "multi_hop": true, "base_id": "multi-hop-03", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 14.0761, "injected_noise_title": "忘记密码怎么办", "noise_position": 2}
{"id": "exact-match-01-noise-01", "layer": "generation", "category": "exact-match", "difficulty": "medium", "question": "错误码 E041 是什么意思？", "query": "错误码 E041 是什么意思？", "golden_answer": "E041 表示优惠券不可用。常见原因：券已过期、超出使用门槛、限品类券用于非指定商品、定制类商品不参与、与另一张券叠加使用等。自查：核对券面有效期与满减门槛（满 ¥199 减 ¥20、满 ¥499 减 ¥60、满 ¥999 减 ¥150），每单限用 1 张。", "golden_context": ["error-codes", "billing-invoices"], "golden_context_ids": ["error-codes", "billing-invoices"], "metadata_filter": {"source": "error-codes"}, "answer_type": "精确匹配", "key_points": ["E041", "优惠券不可用", "满减门槛"], "reference_points": ["E041", "优惠券不可用", "满减门槛"], "should_refuse": false, "weight": 1.0, "golden_sections": ["billing-invoices::优惠券规则", "error-codes::E041 优惠券不可用"], "golden_chunk_ids": ["billing-invoices:p1:c2", "billing-invoices:p1:c3", "error-codes:p5:c0", "error-codes:p5:c1"], "intent": "精确匹配", "emotion": "neutral", "sg": true, "base_id": "exact-match-01", "noise_probe": true, "injected_noise_chunk_id": "README:p0:c0", "injected_noise_source": "README", "injected_noise_score": 8.2605, "injected_noise_title": "knowledge/：知识库原文", "noise_position": 2}
{"id": "exact-match-02-noise-02", "layer": "generation", "category": "exact-match", "difficulty": "hard", "question": "E014 子设备数量上限是多少？G1 和 G2 Pro 分别支持多少？", "query": "E014 子设备数量上限是多少？G1 和 G2 Pro 分别支持多少？", "golden_answer": "E014 指接入子设备数达到上限：G1 上限 64 个，G2 Pro 上限 128 个（X-300 Pro 同样 128 个）。处理：App「设备管理」删除闲置/离线子设备；多网关分流——同账号可添加多个网关，子设备就近入网。属容量限制非故障。", "golden_context": ["error-codes"], "golden_context_ids": ["error-codes"], "metadata_filter": {"source": "error-codes"}, "answer_type": "精确匹配", "key_points": ["G1=64", "G2 Pro=128", "X-300 Pro=128"], "reference_points": ["G1=64", "G2 Pro=128", "X-300 Pro=128"], "should_refuse": false, "weight": 1.0, "golden_sections": ["error-codes::E014 网关子设备数量已达上限"], "golden_chunk_ids": ["error-codes:p1:c3"], "intent": "精确匹配", "emotion": "neutral", "sg": true, "base_id": "exact-match-02", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 30.6522, "injected_noise_title": "一个账号能绑定多少台设备", "noise_position": 2}
{"id": "exact-match-03-noise-03", "layer": "generation", "category": "exact-match", "difficulty": "medium", "question": "X-100 音箱支持 5GHz WiFi 吗？", "query": "X-100 音箱支持 5GHz WiFi 吗？", "golden_answer": "不支持。X-100 仅支持 2.4GHz 网络；X-200 和 X-300 Pro 支持 2.4G/5G 双频。配网时若路由器开了 5G 单频，X-100 会无法连接，需在路由器开启 2.4G 频段或使用双频合一。", "golden_context": ["product-manual"], "golden_context_ids": ["product-manual"], "metadata_filter": {"source": "product-manual"}, "answer_type": "精确匹配", "key_points": ["X-100仅2.4GHz", "X-200/X-300 Pro双频"], "reference_points": ["X-100仅2.4GHz", "X-200/X-300 Pro双频"], "should_refuse": false, "weight": 1.0, "golden_sections": ["product-manual::产品线总览", "product-manual::智能音箱 X-100(青春版)详细参数"], "golden_chunk_ids": ["product-manual:p0:c0", "product-manual:p0:c2", "product-manual:p0:c3"], "intent": "精确匹配", "emotion": "neutral", "sg": true, "base_id": "exact-match-03", "noise_probe": true, "injected_noise_chunk_id": "troubleshooting:p0:c0", "injected_noise_source": "troubleshooting", "injected_noise_score": 24.4501, "injected_noise_title": "音箱 WiFi 连接失败", "noise_position": 2}
{"id": "privilege-expiry-01-noise-01", "layer": "generation", "category": "privilege-expiry", "difficulty": "hard", "question": "我是普通家庭成员，能删掉管理员添加的设备吗？", "query": "我是普通家庭成员，能删掉管理员添加的设备吗？", "golden_answer": "不能。家庭成员权限分两级：管理员可添加/删除设备、编辑场景；普通成员仅查看与控制。删除设备需管理员操作。若你已是管理员仍无法操作，确认使用的是主账号而非成员账号。", "golden_context": ["account-security"], "golden_context_ids": ["account-security"], "metadata_filter": {"source": "account-security"}, "answer_type": "事实问答", "key_points": ["普通成员仅查看控制", "管理员才能删设备"], "reference_points": ["普通成员仅查看控制", "管理员才能删设备"], "should_refuse": false, "weight": 1.0, "golden_sections": ["account-security::家庭共享与成员权限"], "golden_chunk_ids": ["account-security:p1:c0", "account-security:p1:c1"], "intent": "事实问答", "emotion": "neutral", "sg": true, "base_id": "privilege-expiry-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 20.1513, "injected_noise_title": "可以在一个家里用多个账号吗", "noise_position": 2}
{"id": "privilege-expiry-02-noise-02", "layer": "generation", "category": "privilege-expiry", "difficulty": "hard", "question": "被移出家庭后，我还能看到之前的摄像头录像吗？", "query": "被移出家庭后，我还能看到之前的摄像头录像吗？", "golden_answer": "不能。成员退出或被移除后立即失去全部访问权，包括摄像头画面与历史录像。摄像头画面默认仅主账号可见，需单独为成员开启「摄像头查看」授权，移除后授权同步失效。", "golden_context": ["account-security"], "golden_context_ids": ["account-security"], "metadata_filter": {"source": "account-security"}, "answer_type": "事实问答", "key_points": ["立即失去访问权", "摄像头需授权"], "reference_points": ["立即失去访问权", "摄像头需授权"], "should_refuse": false, "weight": 1.0, "golden_sections": ["account-security::家庭共享与成员权限"], "golden_chunk_ids": ["account-security:p1:c0", "account-security:p1:c1"], "intent": "事实问答", "emotion": "neutral", "sg": true, "base_id": "privilege-expiry-02", "noise_probe": true, "injected_noise_chunk_id": "billing-invoices:p0:c0", "injected_noise_source": "billing-invoices", "injected_noise_score": 17.2372, "injected_noise_title": "计费相关常见对话示例", "noise_position": 2}
{"id": "privilege-expiry-03-noise-03", "layer": "generation", "category": "privilege-expiry", "difficulty": "hard", "question": "员工能看到我的摄像头录像吗？", "query": "员工能看到我的摄像头录像吗？", "golden_answer": "不能。所有数据传输与存储采用 AES-256 加密，服务器通过等保三级认证；摄像头视频仅账号本人及被授权的家庭成员可访问，员工无查看权限。维修调试需用户在工作单中临时授权，且操作留痕。", "golden_context": ["account-security"], "golden_context_ids": ["account-security"], "metadata_filter": {"source": "account-security"}, "answer_type": "事实问答", "key_points": ["员工无查看权限", "AES-256", "临时授权留痕"], "reference_points": ["员工无查看权限", "AES-256", "临时授权留痕"], "should_refuse": false, "weight": 1.0, "golden_sections": ["account-security::数据安全承诺"], "golden_chunk_ids": ["account-security:p1:c4", "account-security:p2:c0"], "intent": "事实问答", "emotion": "neutral", "sg": true, "base_id": "privilege-expiry-03", "noise_probe": true, "injected_noise_chunk_id": "billing-invoices:p0:c0", "injected_noise_source": "billing-invoices", "injected_noise_score": 16.8784, "injected_noise_title": "计费相关常见对话示例", "noise_position": 2}
{"id": "comparison-01-noise-01", "layer": "generation", "category": "comparison", "difficulty": "medium", "question": "标准快递和加急快递有什么区别？", "query": "标准快递和加急快递有什么区别？", "golden_answer": "标准快递 2-5 个工作日送达，满 ¥99 免运费、不满收 ¥10，覆盖全国；加急快递 1-2 个工作日送达，运费 ¥15，仅覆盖全国主要城市。偏远地区（新疆、西藏、青海及内蒙部分地区）标准快递 5-8 个工作日，且不支持加急与次日达。", "golden_context": ["shipping-logistics"], "golden_context_ids": ["shipping-logistics"], "metadata_filter": {"source": "shipping-logistics"}, "answer_type": "对比", "key_points": ["标准2-5天/满99免运", "加急1-2天/¥15", "偏远不支持加急"], "reference_points": ["标准2-5天/满99免运", "加急1-2天/¥15", "偏远不支持加急"], "should_refuse": false, "weight": 1.0, "golden_sections": ["shipping-logistics::配送方式与运费"], "golden_chunk_ids": ["shipping-logistics:p0:c0", "shipping-logistics:p0:c1", "shipping-logistics:p0:c2"], "intent": "对比", "emotion": "urgent", "required_key_points": ["标准2-5天/满99免运", "加急1-2天/¥15", "偏远不支持加急"], "sg": true, "base_id": "comparison-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 20.6918, "injected_noise_title": "下单后多久发货、多久到货", "noise_position": 2}
{"id": "comparison-02-noise-02", "layer": "generation", "category": "comparison", "difficulty": "hard", "question": "免费版、家庭版、专业版云存储有什么区别？", "query": "免费版、家庭版、专业版云存储有什么区别？", "golden_answer": "免费版 5GB、价格 ¥0；家庭版 50GB、¥18/月或 ¥180/年；专业版 500GB、¥38/月或 ¥380/年（年付相当于 10 个月价格）。录像回放期限也不同：免费版 3 天滚动、家庭版 30 天、专业版 90 天。升级套餐立即生效，按旧套餐剩余天数比例折抵新套餐费用。", "golden_context": ["billing-invoices", "error-codes"], "golden_context_ids": ["billing-invoices", "error-codes"], "metadata_filter": {"source": "billing-invoices"}, "answer_type": "对比", "key_points": ["免费5GB/家庭50GB/专业500GB", "回放3/30/90天", "年付10个月价"], "reference_points": ["免费5GB/家庭50GB/专业500GB", "回放3/30/90天", "年付10个月价"], "should_refuse": false, "weight": 1.0, "golden_sections": ["billing-invoices::云服务订阅计费规则", "error-codes::E031 回放文件不存在"], "golden_chunk_ids": ["billing-invoices:p0:c4", "billing-invoices:p1:c0", "error-codes:p3:c4", "error-codes:p4:c0"], "intent": "对比", "emotion": "neutral", "required_key_points": ["免费5GB/家庭50GB/专业500GB", "回放3/30/90天", "年付10个月价"], "sg": true, "base_id": "comparison-02", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 24.0563, "injected_noise_title": "云服务免费版够用吗", "noise_position": 2}
{"id": "comparison-03-noise-03", "layer": "generation", "category": "comparison", "difficulty": "hard", "question": "G1 和 G2 Pro 网关有什么区别？", "query": "G1 和 G2 Pro 网关有什么区别？", "golden_answer": "主要区别：子设备容量——G1 上限 64 个，G2 Pro 上限 128 个（X-300 Pro 同样 128 个）；网络接入——G2 Pro 优先插网线（有线回程），G1 依赖 WiFi；备用电池——G2 Pro 内置备用电池，正常断电续航 4 小时，备用电池异常见 E024。两者均支持多网关分流，同账号可添加多个网关。", "golden_context": ["error-codes"], "golden_context_ids": ["error-codes"], "metadata_filter": {"source": "error-codes"}, "answer_type": "对比", "key_points": ["G1=64子设备/G2Pro=128", "G2Pro优先网线", "G2Pro备电4小时"], "reference_points": ["G1=64子设备/G2Pro=128", "G2Pro优先网线", "G2Pro备电4小时"], "should_refuse": false, "weight": 1.0, "golden_sections": ["error-codes::E011 网关离线", "error-codes::E014 网关子设备数量已达上限", "error-codes::E024 网关备用电池异常"], "golden_chunk_ids": ["error-codes:p1:c1", "error-codes:p1:c2", "error-codes:p1:c3", "error-codes:p3:c0"], "intent": "对比", "emotion": "neutral", "required_key_points": ["G1=64子设备/G2Pro=128", "G2Pro优先网线", "G2Pro备电4小时"], "sg": true, "base_id": "comparison-03", "noise_probe": true, "injected_noise_chunk_id": "product-manual:p0:c0", "injected_noise_source": "product-manual", "injected_noise_score": 17.0397, "injected_noise_title": "智能家居网关 G1 / G2 Pro 参数", "noise_position": 2}
{"id": "summary-01-noise-01", "layer": "generation", "category": "summary", "difficulty": "easy", "question": "总结一下退货流程。", "query": "总结一下退货流程。", "golden_answer": "退货流程四步：1) 申请——App「我的订单」选对应订单点「申请退货」，质量问题上传照片/视频，无理由退货填原因；2) 审核——客服 1 个工作日内审核，通过后提供退货地址与 RMA 号，未获 RMA 号前勿自行寄回；3) 寄回——寄出并填写快递单号，保留底单，赠品需一并退回；4) 退款——仓库签收验货（1-2 个工作日）通过后 3 个工作日内发起退款。", "golden_context": ["returns-refunds"], "golden_context_ids": ["returns-refunds"], "metadata_filter": {"source": "returns-refunds"}, "answer_type": "摘要", "key_points": ["申请", "审核得RMA", "寄回", "验货后退款"], "reference_points": ["申请", "审核得RMA", "寄回", "验货后退款"], "should_refuse": false, "weight": 1.0, "golden_sections": ["returns-refunds::15 天质量问题退换条件", "returns-refunds::退货政策总览", "returns-refunds::退货申请流程"], "golden_chunk_ids": ["returns-refunds:p0:c1", "returns-refunds:p0:c2", "returns-refunds:p0:c0", "returns-refunds:p0:c3"], "intent": "摘要", "emotion": "neutral", "required_key_points": ["申请", "审核得RMA", "寄回", "验货后退款"], "sg": true, "base_id": "summary-01", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 14.254, "injected_noise_title": "退货期限是多久", "noise_position": 2}
{"id": "summary-02-noise-02", "layer": "generation", "category": "summary", "difficulty": "medium", "question": "保修政策主要包含哪些内容？概括一下。", "query": "保修政策主要包含哪些内容？概括一下。", "golden_answer": "保修政策要点：1) 期限——音箱整机 1 年、主要部件 2 年；网关 2 年；传感器 1 年；执行器类（灯泡、插座、窗帘电机）1.5 年；电池属消耗品不保修；2) 范围——覆盖非人为性能故障与部件损坏，不含人为进水、摔碰、自行拆机；3) 申请——App「售后报修」或 400-888-8888，远程诊断 5 分钟，硬件问题免费上门取件；4) 延保——音箱 ¥299 延至 3 年、¥499 延至 5 年。", "golden_context": ["warranty-service"], "golden_context_ids": ["warranty-service"], "metadata_filter": {"source": "warranty-service"}, "answer_type": "摘要", "key_points": ["期限明细", "覆盖范围", "申请方式", "延保"], "reference_points": ["期限明细", "覆盖范围", "申请方式", "延保"], "should_refuse": false, "weight": 1.0, "golden_sections": ["warranty-service::保修期限总表", "warranty-service::智能音箱保修范围", "warranty-service::保修申请流程", "warranty-service::延保服务"], "golden_chunk_ids": ["warranty-service:p0:c0", "warranty-service:p0:c1", "warranty-service:p0:c3", "warranty-service:p0:c4", "warranty-service:p1:c2", "warranty-service:p1:c3"], "intent": "摘要", "emotion": "neutral", "required_key_points": ["期限明细", "覆盖范围", "申请方式"], "sg": true, "base_id": "summary-02", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 16.6854, "injected_noise_title": "产品保修期是多久", "noise_position": 2}
{"id": "summary-03-noise-03", "layer": "generation", "category": "summary", "difficulty": "hard", "question": "云服务的计费规则都有哪些？帮我梳理一遍。", "query": "云服务的计费规则都有哪些？帮我梳理一遍。", "golden_answer": "云服务计费规则梳理：1) 套餐——免费 5GB / 家庭 50GB（¥18/月或 ¥180/年）/ 专业 500GB（¥38/月或 ¥380/年），年付等于 10 个月价格；2) 订阅——立即生效按自然周期计费（如 3 月 5 日订阅则每月 5 日扣费），升级按剩余天数折抵、降级周期结束后生效；3) 自动续费——到期自动扣款，扣费前 3 天提醒，可随时关闭；扣费失败第 1、3 天重试，均失败降为免费版；4) 退订——随时退，退款=实付×剩余天数÷总天数，1-7 个工作日原路退回；5) 超量——到期续费降为免费版后超出 5GB 数据保留 30 天供下载。", "golden_context": ["billing-invoices"], "golden_context_ids": ["billing-invoices"], "metadata_filter": {"source": "billing-invoices"}, "answer_type": "摘要", "key_points": ["套餐价格", "订阅周期", "自动续费", "退订退款", "超量处理"], "reference_points": ["套餐价格", "订阅周期", "自动续费", "退订退款", "超量处理"], "should_refuse": false, "weight": 1.0, "golden_sections": ["billing-invoices::云服务订阅计费规则", "billing-invoices::云服务退订退款计算", "billing-invoices::自动续费与扣费提醒"], "golden_chunk_ids": ["billing-invoices:p0:c4", "billing-invoices:p1:c0", "billing-invoices:p1:c1", "billing-invoices:p1:c2"], "intent": "摘要", "emotion": "neutral", "required_key_points": ["套餐价格", "订阅周期", "自动续费", "退订退款", "超量处理"], "sg": true, "base_id": "summary-03", "noise_probe": true, "injected_noise_chunk_id": "faq:p0:c0", "injected_noise_source": "faq", "injected_noise_score": 12.7592, "injected_noise_title": "支持哪些支付方式", "noise_position": 2}
