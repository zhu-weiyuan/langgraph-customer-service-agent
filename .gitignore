# Secrets — never commit
.env
.env.*
!.env.example

# Databases
*.db
*.sqlite
*.sqlite3

# Logs
*.log
*.err.log
*.out.log
*.stderr.log
*.stdout.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Linting
.ruff_cache/

# Generated output
*.csv
*.jsonl
_tmp_*
*_result*.json
*_result*.csv
pytest_output.txt
root_files.txt
tests_files.txt

# Backup files
*.bak

# Docker runtime
docker-compose.override.yml

# ChromaDB
chroma_db/

# Node (frontend)
frontend/node_modules/
frontend/dist/

# Runtime / scratch dirs (never commit)
/data/
/work/
/logs/
/archive/*
!/archive/README.md
!/archive/__init__.py
!/archive/legacy_backend/
!/archive/legacy_backend/**
!/archive/legacy_root_tests/
!/archive/legacy_root_tests/**
/memory/

# SQLite WAL artifacts
*.db-shm
*.db-wal
*.pid

# Recovery backups
agent/nodes.py.before_stream_rebuild_20260730
agent/nodes.py.corrupted_20260730_recovery

# Scratch eval scripts & diagnostic outputs (real harness lives in eval/)
eval/_*.py
eval/_*.txt
eval/*.log

# Generated eval reports (regenerated each run)
eval/reports/

# Keep the golden dataset despite the *.jsonl rule
!eval/golden_set_v2.jsonl

# Legacy evaluation scripts may write local, reproducible result artifacts.
# Keep the source datasets and harnesses in Git; keep run outputs out of it.
eval/comparison_details.json
eval/four_rag_eval_llm_subset.json
eval/four_rag_eval_local.json
eval/llm_query_rewrite_cache.json
eval/three_rag_eval_local.json
eval/vector_agentic_details.json

# Archive documentation/source is versioned; interpreter caches are not.
/archive/**/__pycache__/
/archive/**/*.py[cod]

# Keep explicitly archived legacy tests/documentation versioned.
!/archive/legacy_tests/
!/archive/legacy_tests/**

# Re-apply cache ignores after unignoring the archived source tree.
/archive/legacy_tests/**/__pycache__/
/archive/legacy_tests/**/*.py[cod]