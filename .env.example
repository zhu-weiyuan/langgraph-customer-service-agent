# ──────────────────────────────────────────────────────────────
# langgraph-customer-service-agent  —  Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
USE_POSTGRES=1
DATABASE_URL=postgresql://langgraph:PASSWORD@127.0.0.1:5432/langgraph
POSTGRES_DSN=postgresql://langgraph:PASSWORD@127.0.0.1:5432/langgraph
PG_DSN=postgresql://langgraph:PASSWORD@127.0.0.1:5432/langgraph
RAG_PG_DSN=postgresql://langgraph:PASSWORD@127.0.0.1:5432/langgraph
PG_CONNECT_TIMEOUT=5
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=20
PG_POOL_TIMEOUT_SECONDS=5

# ── Readiness / Health ───────────────────────────────────────
READINESS_CACHE_SECONDS=3
READINESS_PROBE_TIMEOUT_SECONDS=3
HEALTH_CACHE_SECONDS=5
METRICS_CACHE_SECONDS=1

# ── Rate Limiting (token-bucket, four layers) ────────────────
MAX_CONCURRENT_REQUESTS=64
RATE_LIMIT_GLOBAL_RATE=500
RATE_LIMIT_GLOBAL_CAPACITY=1000
RATE_LIMIT_IP_RATE=500
RATE_LIMIT_IP_CAPACITY=1000
RATE_LIMIT_USER_RATE=2
RATE_LIMIT_USER_CAPACITY=10
RATE_LIMIT_SESSION_RATE=1
RATE_LIMIT_SESSION_CAPACITY=5

# ── Background Queue ─────────────────────────────────────────
IMPLICIT_SIGNAL_QUEUE_SIZE=1024
IMPLICIT_SIGNAL_WORKERS=4
BACKGROUND_DRAIN_SECONDS=5

# ── Redis (token-bucket sharing across workers) ──────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── LLM (OpenAI-compatible endpoint) ─────────────────────────
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-your-openai-api-key

# ── RAG Backend ──────────────────────────────────────────────
RAG_BACKEND=pgvector

# ── Embedding ────────────────────────────────────────────────
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ALLOW_TRUNCATION=1
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=0

# ── Reranker ─────────────────────────────────────────────────
RERANKER_API_KEY=sk-your-reranker-api-key
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_TIMEOUT_SECONDS=15
RAG_RERANKER=remote

# ── Server ───────────────────────────────────────────────────
PORT=7860
WORKERS=2
LOG_LEVEL=INFO

# ?? Browser Authentication ????????????????????????????????????
# Access JWT is short-lived and kept in browser memory only.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token is opaque, HttpOnly, rotated, and persisted as a hash in PostgreSQL.
JWT_REFRESH_TTL_SECONDS=1209600
# Optional separate HMAC pepper; use a long random value in real deployments.
REFRESH_TOKEN_PEPPER=replace-with-a-separate-long-random-secret
# Local compatibility only. This flag is ignored in production; production identity must be JWT.
AUTH_ALLOW_HEADER_FALLBACK=1
# This is forced to 1 in production; keep 0 for local http://localhost development.
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=lax
# Comma-separated trusted browser origins for production refresh requests.
# AUTH_TRUSTED_ORIGINS=https://your-domain.example


# ── RAG quality knobs (see agent/rag_backend.py) ─────────────
# Minimum rerank score for a context to survive filtering (0.0 = keep everything).
RAG_MIN_RERANK_SCORE=0.05
# Minimum number of contexts returned even when scores are low (fallback safety).
RAG_MIN_RESULTS=3

# ── Auth ─────────────────────────────────────────────────────
# HMAC secret for JWT signing. Production REQUIRES >= 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
