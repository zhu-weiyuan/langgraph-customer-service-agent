# =============================================================
# WARNING: This is a TEMPLATE. Copy to .env and fill in values.
# NEVER commit real API keys or secrets to version control.
# =============================================================

# LLM Configuration (OpenAI-compatible API)
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=sk-your-openai-compatible-key-here
OPENAI_MODEL=your-model-name

# LLM Gateway (agent/llm_gateway.py reads this; requests fail with a
# clear error if it is empty)
LLM_API_KEY=sk-your-llm-gateway-key-here

# Embedding Configuration (for vector RAG)
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=sk-or-v1-your-openrouter-key-here
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Security (required in production — compose fails fast if unset)
JWT_SECRET=generate-a-random-secret-at-least-32-characters-long
API_KEYS=your-secret-api-key-1,your-secret-api-key-2

# Server
PORT=7860

# Redis (optional caching)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
