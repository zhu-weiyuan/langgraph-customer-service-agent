# Secrets — never into the image
.env
.env.*
!.env.example

# VCS
.git/
.gitignore

# Virtual envs
.venv/
venv/
env/

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# Databases & runtime data (bind-mounted in prod)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
/data/
/work/
/logs/
/archive/
/memory/
checkpoints/
checkpoints.db
runtime.db
user_memory.db
backend_new.log

# Vector store local dir
chroma_db/

# Frontend build deps (built separately or served statically)
frontend/node_modules/
frontend/dist/

# Reports / scratch eval artifacts (harness itself is kept)
eval/reports/
eval/_*.py
eval/*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
